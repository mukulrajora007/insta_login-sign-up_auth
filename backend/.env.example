# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Signing
JWT_SECRET=super_secret_instagram_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
# Replace these with your actual Supabase URL and keys:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional Service Role Key (bypasses RLS if needed for admin backend actions)
SUPABASE_SERVICE_ROLE_KEY=
